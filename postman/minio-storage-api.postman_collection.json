{
  "info": {
    "_postman_id": "minio-storage-api-collection",
    "name": "MinIO Storage API",
    "description": "Coleção para testar a API de armazenamento de objetos com MinIO",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        }
      }
    },
    {
      "name": "Upload Arquivo",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "http://localhost:3000/api/upload",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "upload"]
        }
      }
    },
    {
      "name": "Listar Arquivos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/files",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "files"]
        }
      }
    },
    {
      "name": "Download Arquivo (Stream)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/files/:name",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "files", ":name"],
          "variable": [
            {
              "key": "name",
              "value": "teste.txt"
            }
          ]
        }
      }
    },
    {
      "name": "Download Arquivo (Presigned URL)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/files/:name?mode=url&expires=3600",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "files", ":name"],
          "query": [
            {
              "key": "mode",
              "value": "url"
            },
            {
              "key": "expires",
              "value": "3600"
            }
          ],
          "variable": [
            {
              "key": "name",
              "value": "teste.txt"
            }
          ]
        }
      }
    },
    {
      "name": "Deletar Arquivo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/files/:name",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "files", ":name"],
          "variable": [
            {
              "key": "name",
              "value": "teste.txt"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ]
}
